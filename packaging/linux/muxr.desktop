[Desktop Entry]
Type=Application
Name=Muxr
GenericName=Media Converter
Comment=Convert video, audio, images, documents and discs
Exec=muxr %F
Icon=muxr
Terminal=false
Categories=AudioVideo;Video;Audio;Graphics;Utility;
Keywords=convert;converter;video;audio;mp4;mp3;pdf;download;
MimeType=video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/x-flv;video/mpeg;audio/mpeg;audio/flac;audio/x-wav;audio/ogg;audio/aac;image/png;image/jpeg;image/webp;application/pdf;
StartupWMClass=muxr
StartupNotify=true
